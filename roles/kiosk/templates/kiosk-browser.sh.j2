#!/bin/sh
set -u

pause_file="$HOME/.config/kiosk/paused"
profile_dir="$HOME/.local/share/kiosk/chromium-profile"
lock_file="$HOME/.config/kiosk/launcher.lock"

exec 9>"$lock_file"
flock -n 9 || exit 0

while :; do
    if [ -e "$pause_file" ]; then
        sleep 2
        continue
    fi

    systemd-cat --identifier=kiosk-chromium -- \
        {{ kiosk_browser_binary | quote }} \
        --user-data-dir="$profile_dir" \
        --no-first-run \
        --no-default-browser-check \
        --noerrdialogs \
        --disable-session-crashed-bubble \
        --password-store=basic \
{% if kiosk_browser_mode == 'app' %}
        --start-maximized \
        --app={{ kiosk_url | quote }}
{% else %}
        --kiosk \
        {{ kiosk_url | quote }}
{% endif %}

    sleep {{ kiosk_restart_delay | int }}
done
